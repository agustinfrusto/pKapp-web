{
  "expo": {
    "name": "pKapp",
    "slug": "pkapp",
    "version": "0.5.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a3f6f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agustinfrusto.pkapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6366f1"
      },
      "package": "com.agustinfrusto.pkapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "d21e263c-476a-45bf-b355-52d5df4e6005"
      }
    },
    "owner": "agustinfrusto"
  }
}
