{
  "expo": {
    "name": "pKapp",
    "slug": "pkapp",
    "version": "1.10.3",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "favicon": "./src/assets/favicon.png",
      "bundler": "metro",
      "name": "pKapp",
      "shortName": "pKapp",
      "description": "Practicá para ESFUNO con preguntas de examen. Gratis, sin publicidad y en el celular.",
      "lang": "es",
      "themeColor": "#0b0d10",
      "backgroundColor": "#0b0d10",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/"
    },
    "icon": "./src/assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b0d10"
        }
      ]
    ]
  }
}
