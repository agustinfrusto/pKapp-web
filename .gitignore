ESFUNO/
# Originales en alta de las imagenes de materias: al repo va solo la version reducida
Imagenes materias/
# Referencias visuales para el Diseñador: material de terceros, no se distribuye
referencias-diseno/
# PNG regenerables por openspec/diseno/favicon/generar.py; los publicados viven en public/
openspec/diseno/favicon/*.png
openspec/changes/**/diseno/favicon/*.png
tools/ingesta/salidas/
tools/ingesta/.venv/
.venv/
__pycache__/
*.pyc

# Notas personales (no para distribución)
docs/LAUNCH-PLAYBOOK.md
docs/CLOUDFLARE-MIGRATION.md

# Tooling de agentes: lo genera el harness, no es del proyecto
.agents/
skills-lock.json
.atl/
.codegraph/
.orca/
