{
  "name": "pkapp",
  "version": "1.10.5",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "conteos": "node scripts/gen-conteos.mjs",
    "build:web": "node --no-warnings scripts/verificar-avisos.mjs && node scripts/gen-conteos.mjs && expo export -p web --output-dir \"${PKAPP_DIST:-dist}\" && node scripts/inject-pwa.js && node scripts/verificar-bundle.mjs",
    "screenshots": "node scripts/capturar-screenshots.js",
    "pree2e": "node --no-warnings tools/ui/avisos.mjs && node tools/ui/ilustraciones.mjs && node tools/ui/fuentes.mjs && node tools/ui/escalas.mjs && node tools/ui/glifos.mjs && node tools/ui/legado.mjs && node tools/ui/analitica.mjs",
    "e2e": "node tools/e2e/correr.js",
    "e2e:paralelo": "node tools/e2e/pruebas/paralelo.js"
  },
  "dependencies": {
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "^0.2.6",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0"
  },
  "private": true,
  "overrides": {
    "nanoid": "^3.3.18",
    "decode-uri-component": "^0.5.0",
    "postcss-selector-parser": "^7.1.6"
  }
}
